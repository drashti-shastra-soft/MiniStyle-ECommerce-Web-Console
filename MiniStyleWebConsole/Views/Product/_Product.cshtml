@model MiniStyleWebConsole.Domain.Product

<div class="card">
    <div class="card-body">
        @Html.HiddenFor(m => m.Id)
        <div class="row mb-3">
            <div class="col">
                <label>Sub Category <span class="text-danger">*</span></label>
                @Html.DropDownListFor(m => m.SubCategoryId, ViewBag.SubCategory as List<SelectListItem>, "Select Sub Category", new { @class = "form-control" })
                <span class="text-danger"></span>
            </div>
            <div class="col">
                <label>Micro Category</label>
                @Html.DropDownListFor(m => m.MicroCategoryId, ViewBag.MicroCategory as List<SelectListItem>, "Select Micro Category", new { @class = "form-control" })
                <span class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col">
                <label>Code <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.Code, new { @class = "form-control", placeholder = "Enter Code" })
                <span class="text-danger"></span>
            </div>
            <div class="col">
                <label>Name <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                <span class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col">
                <label>Short Info <span class="text-danger">*</span></label>
                @Html.TextAreaFor(m => m.ShortInfo, new { @class = "form-control", placeholder = "Enter Short Description", rows = 5 })
                <span class="text-danger"></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col">
                <div class="form-check">
                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                    <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer clearfix" style="background-color: white; text-align:right">
        <a href="javascript:void(0);" class="btn btn-primary btn-submit">Save</a>
    </div>
</div>

<script>
    $(document).ready(function () {
        $(".btn-submit").click(function () {
            if (fnValidation()) {
                $('#frmProduct').submit();
            }
        });

        var notificationType = $.trim('@ViewBag.NotificationType');
        var notificationMsg = $.trim('@ViewBag.NotificationMsg');

        if (notificationType != null && notificationType != undefined && notificationType != '') {
            if (notificationMsg != null && notificationMsg != undefined && notificationMsg != '') {
                showToastr(notificationType, notificationMsg)
            }
        }
    });

    function fnValidation() {
        var isValid = true;
        var code = $.trim($("#Code").val());
        var name = $.trim($("#Name").val());
        var shortInfo = $.trim($("#ShortInfo").val());

        //Code
        if (code == null || code == "" || code == undefined) {
            $("#Code").next("span").text("Code is required!");
            isValid = false;
        } else {
            $("#Code").next("span").text("");
        }

        //Name
        if (name == null || name == "" || name == undefined) {
            $("#Name").next("span").text("Name is required!");
            isValid = false;
        } else {
            $("#Name").next("span").text("");
        }

        //ShortInfo
        if (shortInfo == null || shortInfo == "" || shortInfo == undefined) {
            $("#ShortInfo").next("span").text("ShortInfo is required!");
            isValid = false;
        } else {
            $("#ShortInfo").next("span").text("");
        }

        return isValid;
    }
</script>