@model List<MiniStyleWebConsole.Domain.Color>

<style>
    .gap-5 {
        gap: 5px;
    }

    .myagegroup111 {
        flex-wrap: wrap;
        justify-content: left;
        gap: 10px;
    }

        .myagegroup111 .row {
            width: calc(50% - 0px);
        }
</style>
<div class="card">
    <div class="card-body">
        <div class="row col-md-2 mb-2 myagegroup111">
            @if (Model != null && Model.Count > default(int))
            {
                for (int i = 0; i < Model.Count; i++)
                {
                    <div class="row">
                        <div class="col d-flex align-items-center gap-5">
                            @Html.HiddenFor(m => m[i].Id)
                            @Html.HiddenFor(m => m[i].Name)
                            @Html.CheckBoxFor(m => m[i].IsChecked)
                            @Html.LabelFor(m => m[i].IsChecked, Model[i].Name, new { @class = "m-0" })
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="card-footer clearfix" style="background-color: white; text-align:right">
        <a href="javascript:void(0);" class="btn btn-primary btn-submit">Save</a>
    </div>
</div>

<script>
$(document).ready(function () {
    $(".btn-submit").click(function () {
        if (fnValidation()) {
            $('#frmProductColor').submit();
        }
    });

    var notificationType = $.trim('@ViewBag.NotificationType');
    var notificationMsg = $.trim('@ViewBag.NotificationMsg');

    if (notificationType != null && notificationType != undefined && notificationType != '') {
        if (notificationMsg != null && notificationMsg != undefined && notificationMsg != '') {
            showToastr(notificationType, notificationMsg)
        }
    }
});
</script>