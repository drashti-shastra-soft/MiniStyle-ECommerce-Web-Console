@model MiniStyleWebConsole.Domain.ProductImageViewModel

<style>
    .productDropzone {
        border: 2px solid #01bec5;
        border-radius: 5px;
    }

        .productDropzone .uploadme {
            max-height: 90px;
            margin-bottom: 10px;
        }

    .uploadme img {
        max-width: 100px;
    }

    .uploadTitle {
        font-size: 24px;
        color: #424242;
        text-transform: capitalize;
    }

    #existing-images {
        margin-top: 50px;
    }

    .UploadImageCard {
        position: relative;
        transition: 0.3s ease-in-out;
        padding: 10px;
        border: 1px solid #01bec5;
        border-radius: 5px;
        box-shadow: none !important;
    }


        .UploadImageCard img {
            height: 200px;
            object-fit: cover;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .UploadImageCard .card-body {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            padding: 0px;
            opacity: 0;
        }

        .UploadImageCard:hover .card-body {
            transform: translate(-50%, -50%) scale(1);
            transition: 0.3s ease-in-out;
            opacity: 1;
        }

        .UploadImageCard .btn-delete-image {
            height: 50px;
            width: 50px;
            font-size: 22px;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
        }
</style>

<div class="card">
    <div class="card-body">

        <div class="row mb-3">
            <div class="col">
                <label>Product Color</label>
                @Html.DropDownListFor(m => m.ProductColorId, ViewBag.ProductColorId as SelectList, "Select Color", new { @class = "form-control" })
                <span class="text-danger"></span>
            </div>
        </div>

        <!-- Dropzone -->
        <div class="dropzone" id="productDropzone" style="border: 2px solid #01bec5">
            <div class="dz-message uploadme">
                <img src="~/Content/assets/img/uploadfiles.png" class="img-fluid uploadme" />
                <h3 class="uploadTitle">Drop files here or click to upload</h3>
            </div>
        </div>



        <!-- Existing Images -->
        <div class="row mb-3" id="existing-images">
            @if (Model != null && Model.ProductImages != null && Model.ProductImages.Count > 0)
            {
                foreach (var img in Model.ProductImages)
                {
                    <div class="col-lg-2 col-md-6 col-sm-6 file-card" data-image-id="@img.Id">
                        <div class="card UploadImageCard">
                            <img src="data:@img.MimeType;base64,@img.Base64String" class="card-img-top img-fluid" alt="@img.FileName" />
                            <div class="card-body text-center">
                                <button type="button" class="btn btn-sm btn-danger btn-delete-image" data-id="@img.Id">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</div>

<script>
    var notificationType = $.trim('@ViewBag.NotificationType');
    var notificationMsg = $.trim('@ViewBag.NotificationMsg');

    if (notificationType != null && notificationType != undefined && notificationType != '') {
        if (notificationMsg != null && notificationMsg != undefined && notificationMsg != '') {
            showToastr(notificationType, notificationMsg)
        }
    }

    Dropzone.autoDiscover = false;
    var productDropzone = new Dropzone("#productDropzone", {
        url: "/Product/SaveProductImage",
        autoProcessQueue: true,      // Auto upload on file selection
        uploadMultiple: false,
        parallelUploads: 1,
        paramName: "file",        
        maxFilesize: 3,
        acceptedFiles: ".jpg,.jpeg,.png",
        addRemoveLinks: true,
        init: function () {
            this.on("sending", function (file, xhr, formData) {
                const productId = $("#ProductId").val();
                const productColorId = $("#ProductColorId").val();
                formData.append("productId", productId); // Attach product ID
                formData.append("productColorId", productColorId); // Attach product ID
            });

            this.on("success", function (file, response) {
                productDropzone.removeFile(file); // Clean UI
                const productId = $("#ProductId").val();
                const productColorId = $("#ProductColorId").val();
                fetchProductImages(productId, productColorId);    // Refresh image list
            });

            this.on("error", function (file, errorMessage) {
                if (file.size > 3 * 1024 * 1024) {
                    showToastr('error', `File "${file.name}" exceeds 3 MB limit.`);
                } else {
                    showToastr('error', `Upload failed for ${file.name}: ${errorMessage}`);
                }
                this.removeFile(file);
            });
        }
    });

    async function uploadProductImagesAsync(productId, productColorId, files) {
        for (const file of files) {
            try {
                await uploadSingleFile(productId, productColorId, file);
                await fetchProductImages(productId, productColorId);
                productDropzone.removeFile(file);
            } catch (error) {
                console.error(`Upload failed for ${file.name}:`, error);
                showToastr('error', `Upload failed for ${file.name}: ${error}`);
                break;
            }
        }
    }

    function uploadSingleFile(productId, productColorId, file) {
        return new Promise((resolve, reject) => {
            const formData = new FormData();
            formData.append("productId", productId);
            formData.append("productColorId", productColorId);
            formData.append("file", file);

            $.ajax({
                url: "/Product/SaveProductImage",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    resolve(response);
                },
                error: function (xhr, status, error) {
                    reject(error);
                }
            });
        });
    }

    async function uploadProductImagesAsync(files) {
        const productId = $("#ProductId").val();
        const productColorId = $("#ProductColorId").val();
        for (const file of files) {
            try {
                await uploadSingleFile(productId, productColorId, file);
                await fetchProductImages(productId, productColorId);
            } catch (error) {
                console.error(`Upload failed for ${file.name}:`, error);
                showToastr(result.NotificationType, result.NotificationMsg)
                alert("An upload failed. See console for details.");
                break;
            }
        }
    }

    function uploadSingleFile(productId, productColorId, file) {
        return new Promise((resolve, reject) => {

            const formData = new FormData();
            formData.append("productId", productId);
            formData.append("productColorId", productColorId);
            formData.append("file", file);

            $.ajax({
                url: "/Product/SaveProductImage",
                type: "POST",
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    resolve(response);
                },
                error: function (xhr, status, error) {
                    reject(error);
                }
            });
        });
    }

    function fetchProductImages(productId, productColorId) {
        $.ajax({
            url: `/Product/FetchProductImages?id=${productId}&productColorId=${productColorId}`,
            type: "GET",
            dataType: "json",
            beforeSend: function () {
                $('#loading-element').show();
            },
            success: function (images) {
                const container = document.getElementById("existing-images");
                container.innerHTML = '';
                if (Array.isArray(images) && images.length > 0) {
                    images.forEach(img => {
                        const imageHtml = `
                        <div class="col-lg-2 col-md-4 col-sm-6 file-card" data-image-id="${img.Id}">
                            <div class="card UploadImageCard">
                                <img src="data:${img.MimeType};base64,${img.Base64String}" class="card-img-top img-fluid" alt="${img.FileName}" />
                                <div class="card-body text-center">
                                    <button type="button" class="btn btn-sm btn-danger btn-delete-image" data-id="${img.Id}">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                        container.insertAdjacentHTML('beforeend', imageHtml);
                    });
                }
            },
            error: function (xhr, status, error) {
                $('#loading-element').hide();
                $('#existing-images').empty();
            }, complete: function () {
                $('#loading-element').hide();
            }
        });
    }

    $(document).on("click", ".btn-delete-image", function () {
        var imageId = $(this).data("id");
        var container = $(this).closest(".file-card");

        fnHandleAjaxRequest({
            url: `/Product/DeleteProductImage/${imageId}`,
            onSuccess: function (response) {
                let result = typeof response === 'string' ? JSON.parse(response) : response;
                showToastr(result.NotificationType, result.NotificationMsg)
                container.fadeOut(300, function () { $(this).remove(); });
            }
        });
    });

    $(document).on("change", "#ProductColorId", function () {
        const productId = parseInt($("#ProductId").val());
        const productColorId = parseInt($("#ProductColorId").val());
        if (productId > 0) {
            fetchProductImages(productId, productColorId)
        }
    });
</script>