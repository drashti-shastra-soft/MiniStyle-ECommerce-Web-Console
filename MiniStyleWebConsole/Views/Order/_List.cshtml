@model MiniStyleWebConsole.Domain.OrderLister

<div class="card-body">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th> </th>
                <th>
                    Full Name
                </th>
                <th>
                    Line 1
                </th>
                <th>
                    Line 2
                </th>
                <th>
                    Landmark
                </th>
                <th>
                    City
                </th>
                <th>
                    State
                </th>
                <th>
                    Order Date
                </th>
                <th>
                    Total Amount
                </th>
                <th>
                    Payment Status
                </th>
                <th>
                    Shipping Status
                </th>
                <th colspan="2" class="text-center">
                    Action
                </th>
            </tr>
            <tr>
                <th>

                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.FullName, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.Line1, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.Line2, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.Landmark, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.City, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.State, new { @class = "form-control search-text" })
                </th>

                <th>

                </th>
                <th>

                </th>
                <th>

                </th>
                <th>

                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model != null && Model.List.Count > default(int))
            {
                foreach (var item in Model.List)
                {
                    var rowId = $"row_{item.Id}";
                    <tr id="@rowId">
                        <td class="text-center align-middle">
                            <a href="javascript:void(0);" data-id="@item.Id" class="toggle-child">
                                <i class="fas fa-plus"></i>
                            </a>
                        </td>
                        <td>
                            @item.FullName
                        </td>
                        <td>
                            @item.Line1
                        </td>
                        <td>
                            @item.Line2
                        </td>
                        <td>
                            @item.Landmark
                        </td>
                        <td>
                            @item.City
                        </td>
                        <td>
                            @item.State
                        </td>
                        <td>
                            @item.OrderDate
                        </td>
                        <td>
                            @item.TotalAmount
                        </td>
                        <td>
                            @item.PaymentStatus
                        </td>
                        <td>
                            @item.ShippingStatus
                        </td>
                        <td class="text-center">
                            <a href="javascript:void(0);" data-id="@item.Id" class="btn-edit"><i class="fas fa-edit"></i></a>
                        </td>
                    </tr>
                    <tr id="child_@item.Id" class="child-row" style="display:none;">
                        <td colspan="12" style="padding:20px;">
                            <div id="childContent_@item.Id">

                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="12">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card-footer clearfix" style="background-color: white;">
    <div class="row">
        <div class="col-12">
            <div class="row footer-button-section">
                <div class="col-lg-3 col-xl-3">
                    <div class="page-per-size d-flex align-items-center">
                        @Html.DropDownListFor(m => m.Pagination.PageSize, ViewBag.Pagination as List<SelectListItem> ?? new List<SelectListItem>(), new { @class = "form-control search-pagination set-page-size" })
                        <label>entries per page</label>
                    </div>
                </div>
                <style>
                </style>
                <div class="col-lg-4 offset-xl-1 col-xl-3 d-flex justify-content-center align-items-center">
                    <div class="showing-entry d-flex align-items-center">
                        <h3>@Model.Pagination.PaginationSummary </h3>
                    </div>
                </div>
                <div class="col-lg-5 col-xl-5">
                    <div class="navigation-tab">
                        <input type="button" value="First" class="btn btn-secondary navigation" data-direction="First" />
                        <input type="button" value="Previous" class="btn btn-secondary navigation" data-direction="Previous" />
                        <label> @Model.Pagination.CurrentPage / @Model.Pagination.TotalPage</label>
                        <input type="button" value="Next" class="btn btn-secondary navigation" data-direction="Next" />
                        <input type="button" value="Last" class="btn btn-secondary navigation" data-direction="Last" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.Pagination.Skip)
    @Html.HiddenFor(m => m.Pagination.TotalRecord)
</div>

<script src="@Url.Content("~/custom-js/order/list.js")"></script>

<script type="text/javascript">
    window.paginationConfig = {
    pageSize: @Model.Pagination.PageSize,
    totalPage: @Model.Pagination.TotalPage,
    currentPage: @Model.Pagination.CurrentPage,
    skip: @Model.Pagination.Skip
    };
</script>