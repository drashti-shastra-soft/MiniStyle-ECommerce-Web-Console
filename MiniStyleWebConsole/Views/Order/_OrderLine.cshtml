@model List<MiniStyleWebConsole.Domain.OrderLine>

<div class="card-body">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>     
                <th>
                    Product Code
                </th>
                <th>
                    Product
                </th>                
                <th>
                    Size
                </th>
                <th>
                    Color
                </th>
                <th>
                    Qty
                </th>
                <th>
                    Unit Price
                </th>
                <th>
                    Discount
                </th>
                <th>
                    Total Price
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model != null && Model.Count > default(int))
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.ProductCode
                        </td>
                        <td>
                            @item.Product
                        </td>
                        <td>
                            @item.Size
                        </td>
                        <td>
                            @item.Color
                        </td>
                        <td>
                            @item.Qty
                        </td>
                        <td>
                            @item.UnitPrice
                        </td>
                        <td>
                            @item.DiscountPercentage
                        </td>
                        <td>
                            @if (item.TotalPrice.HasValue)
                            {
                                <span>
                                    @item.TotalPrice.Value.ToString("F2")
                                </span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="9">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
