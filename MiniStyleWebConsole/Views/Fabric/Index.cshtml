@model MiniStyleWebConsole.Domain.FabricLister
@{
    ViewBag.Title = "Fabric";
}

<!--begin::App Content Header-->
<div class="content-wrapper">
    <!--begin::Container-->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                        <li class="breadcrumb-item active">Fabric</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>
    <!--end::Container-->
    <!--begin::App Content-->

    <section class="content">
        <div class="card">
            @using (Ajax.BeginForm("List", "Fabric", new AjaxOptions() { UpdateTargetId = "divList", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmList" }))
            {
                <div id="divList">
                    @Html.Action("List", Model)
                </div>
            }
        </div>
        <div class="card">
            @using (Ajax.BeginForm("Create", "Fabric", new AjaxOptions() { UpdateTargetId = "divCreate", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmCreate" }))
            {
                <div id="divCreate"></div>
            }
        </div>
        <!--end::Row-->
    </section>
</div>
