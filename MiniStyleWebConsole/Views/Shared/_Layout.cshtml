<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title | Mini Style</title>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="@Url.Content("~/Content/pluggins/fontawesome/all.min.css")">

    <!-- Toastr -->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/toastr/toastr.min.css")" />

    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/dropzone/min/dropzone.min.css")" />

    <link rel="stylesheet" href="@Url.Content("~/Content/dist/adminlte.min.css")">

    <!-- Custom -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/custom.css")" />

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">

    <!-- Summernote Css -->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/summernote/summernote-bs4.min.css")" />

    <!-- Bootstrap Color Picker -->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/bootstrap-colorpicker/css/bootstrap-colorpicker.min.css")" />

    <!-- jQuery -->
    <script src="@Url.Content("~/Scripts/plugins/jquery/jquery.min.js")"></script>

    <!-- Bootstrap 4 -->
    <script src="@Url.Content("~/Scripts/plugins/bootstrap/bootstrap.bundle.min.js")"></script>

    <script src="@Url.Content("~/Scripts/plugins/dropzone/min/dropzone.min.js")"></script>

    <!-- AdminLTE App -->
    <script src="@Url.Content("~/Scripts/dist/js/adminlte.min.js")"></script>

    <!-- Toastr -->
    <script src="@Url.Content("~/Scripts/plugins/toastr/toastr.min.js")"></script>

    <!-- Unobtrusive -->
    <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.min.js")"></script>

    <!-- Summernote Js -->
    <script src="@Url.Content("~/Scripts/plugins/summernote/summernote-bs4.min.js")"></script>

    <!-- bootstrap color picker Js -->
    <script src="@Url.Content("~/Scripts/plugins/bootstrap-colorpicker/js/bootstrap-colorpicker.min.js")"></script>

    <!-- Jquery Mask -->
    <script src="@Url.Content("~/Scripts/jquery.mask.min.js")"></script>

    <!-- Custom Notification -->
    <script src="@Url.Content("~/Scripts/JS/custom-notification.js")"></script>

    <!-- Custom Functions -->
    <script src="@Url.Content("~/Scripts/JS/custom-functions.js")"></script>

</head>
<body class="hold-transition sidebar-mini">
    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="@Url.Action("Index", "Dashboard")" class="brand-link">
                @*<img src="@Url.Content("~/Content/assets/img/Admin/ministyle.png")" alt="MiniStyle" class="brand-image img-circle elevation-3" style="opacity: .8">*@
                <img src="@Url.Content("~/Content/assets/img/AdminLTELogo.png")" alt="MiniStyle" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-light">Mini Style App</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar user (optional) -->
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Dashboard")" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>
                                    Dashboard
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-chart-pie"></i>
                                <p>
                                    Master
                                    <i class="right fas fa-angle-left"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "SubCategory")" class="nav-link">
                                        <i class="nav-icon fas fa-layer-group"></i>
                                        <p>Sub Category</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "MicroCategory")" class="nav-link">
                                        <i class="nav-icon fas fa-th-large"></i>
                                        <p>
                                            Micro Category
                                        </p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "AgeGroup")" class="nav-link">
                                        <i class="nav-icon fas fa-user-friends"></i>
                                        <p>
                                            Age Group
                                        </p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Color")" class="nav-link">
                                        <i class="nav-icon fas fa-fill-drip"></i>
                                        <p>
                                            Color
                                        </p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@Url.Action("Index", "Fabric")" class="nav-link">
                                        <i class="nav-icon fas fa-tshirt"></i>
                                        <p>
                                            Fabric
                                        </p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "User")" class="nav-link">
                                <i class="nav-icon fas fa-user-circle"></i>
                                <p>User</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Product")" class="nav-link">
                                <i class="nav-icon fas fa-box"></i>
                                <p>
                                    Product
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Order")" class="nav-link">
                                <i class="nav-icon fas fa-clipboard-list"></i>
                                <p>
                                    Order
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "ChangePassword")" class="nav-link">
                                <i class="nav-icon fas fa-unlock-alt"></i>
                                <p>
                                    Change Password
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Logout")" class="nav-link">
                                <i class="nav-icon fas fa-sign-out-alt"></i>
                                <p>
                                    Logout
                                </p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>

        @RenderBody()

        <div id="loading-element" class="custom-loader">
            <div class="loader">
                <img src="@Url.Content("~/Content/assets/img/Admin/Loading.gif")" style="height:100px;" />
            </div>
            <br />
        </div>

        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 1.0.0
            </div>
            <strong>Copyright &copy;@DateTime.Now.Year <a href="javascript:void(0)">Mini Style App</a>.</strong> All rights reserved.
        </footer>

        <!-- Control Sidebar -->
        <aside class="control-sidebar control-sidebar-dark">
            <!-- Control sidebar content goes here -->
        </aside>
        <!-- /.control-sidebar -->
    </div>
    <!-- ./wrapper -->
</body>
</html>