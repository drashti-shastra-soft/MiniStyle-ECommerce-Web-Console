<style>
    .error-container {
        text-align: center;
        max-width: 620px;
        border: 1px solid #f7f7f7;
        width: 600px;
        border-radius: 5px;
        box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 6px -1px, rgba(0, 0, 0, 0.06) 0px 2px 4px -1px;
        padding: 0 0 50px 0;
    }

    .error-code {
        font-size: 120px;
        font-weight: 600;
        position: relative;
        color: rgb(12 177 185 / 29%);
    }

        .error-code .icon {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            font-size: 80px;
            color: #0cb1b9;
        }

    .error-message {
        font-size: 22px;
        font-weight: 600;
        color: #089097;
    }

    .error-desc {
        font-size: 16px;
        margin-top: 10px;
        color: #7d7d7d;
    }

    .btn-custom {
        background-color: #0cb1b9;
        color: #fff;
        border-radius: 6px;
        padding: 10px 25px;
        margin-top: 25px;
        transition: 0.3s;
    }

        .btn-custom:hover {
            background-color: #089097;
            color: #fff;
        }

    .authentication-errorpage {
        display: flex;
        justify-content: center;
        align-content: center;
        padding: 50px 0;
    }
</style>

