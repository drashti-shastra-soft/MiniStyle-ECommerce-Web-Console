@model MiniStyleWebConsole.Domain.MicroCategory

<div class="modal fade" id="modal-micro-category" tabindex="-1" aria-labelledby="MicroCategoryLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="MicroCategoryLabel">Edit Micro Category</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="MicroCategoryLabel">Add Micro Category</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>

            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                    
                <div class="row mb-3">
                    <div class="col">
                        <label>Sub Category <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.SubCategoryId, ViewBag.SubCategory as List<SelectListItem>, "Select Sub Category", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label>Description</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Enter Description", rows = 5 })
                        <span class="text-danger"></span>
                    </div>
                </div>


                <div class="row mb-3">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                        </div>
                    </div>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)

<script src="@Url.Content("~/custom-js/microcategory/create.js")"></script>